<Project>

  <!-- Central Package Management: alle NuGet-versies van deze repository staan hier. Projecten verwijzen alleen nog naar de package-naam. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CodeCube.Core" Version="4.0.9" />
    <PackageVersion Include="System.ServiceModel.Syndication" Version="10.0.14" />
  </ItemGroup>

</Project>
