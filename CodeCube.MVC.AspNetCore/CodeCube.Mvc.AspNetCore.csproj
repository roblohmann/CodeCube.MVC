<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Company>Rob Lohmann</Company>
    <Copyright>Copyright 2019 - 2026 Rob Lohmann</Copyright>
    <PackageId>CodeCube.Mvc.AspNetCore</PackageId>
    <Product>CodeCube.Mvc.AspNetCore</Product>
    <Description>A set of MVC utilities like menuitems, breadcrumbs, meta tags, Google analytics tags and more.</Description>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageTags>codecube mvc aspnetcore utilities htmlhelpers actionresults rss xml filters</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVC/Http komen op net6+ uit het gedeelde ASP.NET Core-framework, niet meer uit de 2.x-packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeCube.Core" Version="4.0.8" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\nuget-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
